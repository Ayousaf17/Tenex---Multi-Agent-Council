{
  "name": "Realtor.com Expired Listings Scraper (Apify)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24,
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 6 AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "notes": "Runs early to catch expired listings before other investors"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/maxcopell~realtor-scraper/runs?waitForFinish=300",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"location\": \"{{ $env.TARGET_CITY }}, {{ $env.TARGET_STATE }}\",\n  \"maxItems\": 100,\n  \"status\": \"off_market\",\n  \"daysOnMarket\": {\n    \"min\": 60,\n    \"max\": 180\n  },\n  \"proxy\": {\n    \"useApifyProxy\": true\n  }\n}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "apify-run",
      "name": "Run Apify Realtor Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify API Token"
        }
      },
      "notes": "Finds off-market/expired listings. Adjust daysOnMarket filter as needed."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apify.com/v2/datasets/{{ $json.data.defaultDatasetId }}/items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-results",
      "name": "Get Scraper Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify API Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Map Realtor.com data to our lead schema\nconst results = $input.first().json;\nconst items = Array.isArray(results) ? results : [results];\n\nconst leads = items.map(item => {\n  // Realtor.com typically returns structured address\n  const address = item.location?.address || {};\n  \n  return {\n    json: {\n      address: address.line || item.address || '',\n      city: address.city || item.city || '',\n      state: address.state_code || address.state || item.state || '',\n      zip: address.postal_code || item.zip || '',\n      askingPrice: item.list_price || item.price || null,\n      bedrooms: item.description?.beds || item.beds || null,\n      bathrooms: item.description?.baths || item.baths || null,\n      sqft: item.description?.sqft || item.sqft || null,\n      yearBuilt: item.description?.year_built || item.yearBuilt || null,\n      propertyType: item.description?.type || item.propertyType || 'Single Family',\n      description: item.description?.text || '',\n      photos: item.photos?.map(p => p.href) || [],\n      listingUrl: item.href || item.url || '',\n      daysOnMarket: item.list_date ? Math.floor((Date.now() - new Date(item.list_date)) / (1000*60*60*24)) : null,\n      lastListPrice: item.last_sold_price || item.list_price || null,\n      source: 'Realtor Expired',\n      dateFound: new Date().toISOString(),\n      status: 'New',\n      rawData: JSON.stringify(item)\n    }\n  };\n}).filter(lead => lead.json.address);\n\nreturn leads;"
      },
      "id": "map-data",
      "name": "Map to Lead Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "list"
        },
        "filterByFormula": "=LOWER({Address})=LOWER('{{ $json.address }}')"
      },
      "id": "check-duplicate",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1120, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-empty",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-not-exists",
      "name": "If Not Already In DB",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Address": "={{ $('Map to Lead Schema').item.json.address }}",
            "City": "={{ $('Map to Lead Schema').item.json.city }}",
            "State": "={{ $('Map to Lead Schema').item.json.state }}",
            "ZIP": "={{ $('Map to Lead Schema').item.json.zip }}",
            "Source": "Realtor Expired",
            "Status": "New",
            "Asking Price": "={{ $('Map to Lead Schema').item.json.askingPrice }}",
            "Beds": "={{ $('Map to Lead Schema').item.json.bedrooms }}",
            "Baths": "={{ $('Map to Lead Schema').item.json.bathrooms }}",
            "Sqft": "={{ $('Map to Lead Schema').item.json.sqft }}",
            "Year Built": "={{ $('Map to Lead Schema').item.json.yearBuilt }}",
            "Property Type": "={{ $('Map to Lead Schema').item.json.propertyType }}",
            "Listing URL": "={{ $('Map to Lead Schema').item.json.listingUrl }}",
            "Days on Market": "={{ $('Map to Lead Schema').item.json.daysOnMarket }}",
            "Description": "={{ $('Map to Lead Schema').item.json.description }}",
            "Date Found": "={{ $('Map to Lead Schema').item.json.dateFound }}",
            "Priority": "high",
            "Raw Data": "={{ $('Map to Lead Schema').item.json.rawData }}"
          }
        }
      },
      "id": "create-lead",
      "name": "Create Lead in Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1560, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable API"
        }
      },
      "notes": "Expired listings are HIGH PRIORITY - proven motivated sellers"
    },
    {
      "parameters": {
        "channel": "#leads",
        "text": "=:rotating_light: EXPIRED LISTING Found!\n\n*Address:* {{ $('Map to Lead Schema').item.json.address }}, {{ $('Map to Lead Schema').item.json.city }}, {{ $('Map to Lead Schema').item.json.state }}\n*Last Price:* ${{ $('Map to Lead Schema').item.json.askingPrice ? $('Map to Lead Schema').item.json.askingPrice.toLocaleString() : 'N/A' }}\n*Days on Market:* {{ $('Map to Lead Schema').item.json.daysOnMarket || 'Unknown' }}\n*Beds/Baths:* {{ $('Map to Lead Schema').item.json.bedrooms || '?' }}/{{ $('Map to Lead Schema').item.json.bathrooms || '?' }}\n*Source:* Realtor.com Expired (via Apify)\n\n:star: *HIGH PRIORITY* - Owner tried to sell, didn't succeed. Very motivated!\n\n<{{ $('Map to Lead Schema').item.json.listingUrl }}|View Property>",
        "otherOptions": {}
      },
      "id": "slack-notify",
      "name": "Slack Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1780, 200],
      "credentials": {
        "slackApi": {
          "id": "slack-creds",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "Already Exists - Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1560, 400]
    }
  ],
  "connections": {
    "Daily 6 AM Trigger": {
      "main": [
        [
          {
            "node": "Run Apify Realtor Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Apify Realtor Scraper": {
      "main": [
        [
          {
            "node": "Get Scraper Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Scraper Results": {
      "main": [
        [
          {
            "node": "Map to Lead Schema",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map to Lead Schema": {
      "main": [
        [
          {
            "node": "Check Duplicate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Duplicate": {
      "main": [
        [
          {
            "node": "If Not Already In DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Not Already In DB": {
      "main": [
        [
          {
            "node": "Create Lead in Airtable",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Already Exists - Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Lead in Airtable": {
      "main": [
        [
          {
            "node": "Slack Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "wholesale-leadgen",
      "id": "1"
    },
    {
      "name": "engine1-sourcing",
      "id": "2"
    },
    {
      "name": "apify",
      "id": "6"
    },
    {
      "name": "high-priority",
      "id": "7"
    }
  ],
  "pinData": {},
  "meta": {
    "instanceId": "wholesale-leadgen-system"
  }
}
